flowchart TD
    subgraph cli["CLI subcommands"]
        deps["deps check"]
        discover["alice discover"]
        package["alice package"]
        smoke["alice launch-smoke"]
        compare["alice compare-launch-smoke"]
        check_session["alice check-lesson-session"]
        check_readiness["alice check-lesson-readiness"]
        run_first["alice run-first-lesson-readiness"]
        validate["assets validate"]
        gadugi["assets generate-gadugi"]
        grading["assets grading-report"]
    end

    subgraph alice["eatme-alice public API"]
        check["check_dependencies -> DependencyReport"]
        disc["discover_alice -> AliceDiscovery"]
        pack["package_alice -> PackageResult"]
        launch_api["run_launch_smoke -> LaunchSmokeManifest"]
        compare_api["run_launch_smoke_comparison -> AliceComparisonManifest"]
        lesson_contract["check_lesson_session_contract -> LessonSessionContractCheck"]
        lesson_readiness["check_lesson_session_readiness -> LessonSessionReadinessReport"]
        first_lesson["run_first_lesson_readiness_sequence -> FirstLessonReadinessSequenceReport"]
    end

    subgraph core["eatme-core public types"]
        program["Program"]
        procedure["Procedure"]
        statement["Statement"]
        runner["CommandRunner"]
        manifest["LaunchSmokeManifest"]
    end

    subgraph assets["eatme-assets public API"]
        first_grade["grade_first_lesson_readiness -> GradingReport"]
        grade["grade_sequencing -> GradingReport"]
        validate_scenario["validate_scenario_asset"]
        validate_persona["validate_persona_crew"]
        validate_all["validate_assets"]
        generate["generate_gadugi_adapters"]
    end

    subgraph web["Web-platform adapter surface"]
        health["GET /api/health"]
        launch["POST /api/launch"]
        add_object["POST /api/scene/add-object"]
        edit_proc["POST /api/code/edit-procedure"]
        run_world["POST /api/world/run"]
        save_project["POST /api/project/save"]
        register_event["POST /api/events/register"]
        adapter_assert["Response DTOs + StepResult assertions"]
    end

    deps --> check
    discover --> disc
    package --> pack
    smoke --> launch_api
    compare --> compare_api
    check_session --> lesson_contract
    check_readiness --> lesson_readiness
    run_first --> first_lesson
    validate --> validate_scenario
    validate --> validate_persona
    validate --> validate_all
    gadugi --> generate
    grading --> validate_all
    grading --> check
    grading --> first_grade

    check --> runner
    disc --> runner
    pack --> runner
    launch_api --> runner
    compare_api --> runner
    first_lesson --> runner
    launch_api --> manifest
    compare_api --> manifest

    grade --> program
    grade --> procedure
    grade --> statement

    health --> adapter_assert
    launch --> adapter_assert
    add_object --> adapter_assert
    edit_proc --> adapter_assert
    edit_proc --> statement
    run_world --> adapter_assert
    save_project --> adapter_assert
    save_project --> program
    register_event --> adapter_assert
    register_event --> statement
